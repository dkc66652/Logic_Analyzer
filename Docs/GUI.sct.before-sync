LR_IROM1 0x08000000 0x00200000  {    ; load region size_region
  ER_IROM1 0x08000000 0x00200000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  ; DMA2 无法访问 DTCM (0x20000000)。此段专门留给 USART1 TX DMA 源缓冲。
  RW_UART_DMA 0x24000000 0x00000080  {
   uart.o (.uart_dma_tx)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; RW data
   .ANY (+RW +ZI)
  }
  RW_IRAM2 0x24000080 0x0007FF80  {
   .ANY (+RW +ZI)
  }
}

